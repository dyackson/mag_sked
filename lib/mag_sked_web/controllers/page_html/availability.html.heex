<%!-- Rendered both inline on first paint and as the htmx poll response.
      No #availability wrapper: the page container owns that id and htmx
      morphs this in as its innerHTML. --%>
<div>
  <table class="table font-mono">
    <thead></thead>
    <tbody>
      <%= for %{date: date, dow_text: dow_text, avail: avail} <- @snapshot do %>
        <tr class="border-none">
          <td class="font-mono text-base-content/60">
            {"#{dow_text} (#{two_digit(date.day)}.#{two_digit(date.month)})"}
          </td>
          <td class="py-0 text-center">1</td>
          <td class="py-0 text-center">2</td>
          <td class="py-0 text-center">3</td>
        </tr>
        <%= for {block, i} <- Enum.with_index(avail || []) do %>
          <%= for {time, courts} <- block do %>
            <% bookable =
              DateTime.before?(
                DateTime.new!(date, Time.from_iso8601!(time <> ":00"), "Europe/Lisbon"),
                @one_week_away
              ) %>
            <% badge_class = if bookable, do: "badge badge-success", else: "badge badge-secondary" %>
            <tr class="border-none">
              <td class="py-0 text-center leading-none"></td>
              <%= for n <- 1..3 do %>
                <td class="py-0 text-center">
                  <% show = courts[n] %>
                  <span
                    :if={show}
                    class={[
                      badge_class,
                      show in [:mid, :last] and "-mt-1",
                      show == :first and "rounded-b-none",
                      show == :mid and "rounded-none",
                      show == :last and "rounded-t-none"
                    ]}
                  >
                    <span class="">
                      {case show do
                        :first ->
                          time

                        :last ->
                          Time.from_iso8601!(time <> ":00")
                          |> Time.shift(minute: 30)
                          |> to_string()
                          |> String.slice(0, 5)

                        :mid ->
                          "\u00A0\u00A0\u00A0\u00A0\u00A0"
                      end}
                    </span>
                  </span>
                </td>
              <% end %>
            </tr>
          <% end %>
          <%!-- After each block, a blank row --%>
          <tr :if={i + 1 < length(avail || [])} class="border-none">
            <td class="p-0 m-0"></td>
            <td colspan="3" class="p-2 m-0 text-center"></td>
          </tr>
        <% end %>
        <tr class="">
          <td class="p-0 m-0"></td>
          <td colspan="3" class="py-4 m-0 text-center"></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="mt-3 text-xs text-base-content/50">
    <%!-- Updated {Calendar.strftime(@snapshot.fetched_at, "%H:%M:%S")} UTC --%>
  </p>
</div>
