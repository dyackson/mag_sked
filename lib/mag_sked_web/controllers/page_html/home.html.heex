<Layouts.flash_group flash={@flash} />

<div class="fixed z-50 top-[calc(1rem+env(safe-area-inset-top))] right-[calc(1rem+env(safe-area-inset-right))]">
  <.theme_toggle />
</div>

<main class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-base-content">Court availability</h1>
    <p class="mt-1 text-sm text-base-content/60">
      Bookable up to 7 days ahead · refreshes every minute
    </p>

    <%!-- htmx polls /availability every 60s and again whenever the tab is
          re-focused. On a failed request (offline) htmx leaves the current
          DOM untouched — the table just stops updating, no error state.
          idiomorph (hx-ext="morph") patches in place so scroll position and
          the timestamp don't flicker. --%>
    <div
      id="availability"
      class="mt-6 overflow-x-auto"
      hx-get={~p"/availability"}
      hx-trigger="every 60s, visibilitychange[document.visibilityState=='visible'] from:document"
      hx-ext="morph"
      hx-swap="morph:innerHTML"
    >
      <.availability snapshot={@snapshot} />
    </div>
  </div>
</main>
